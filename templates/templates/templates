            Velox Inventory <span class="text-xs px-2 py-0.5 rounded-full bg-blue-500/20 border border-blue-500/30 text-blue-400 font-mono">PRO v2.0</span>
          </h1>
          <p class="text-xs text-slate-400">Automated Stock Alerts, Expiry Tracker & Profit Analytics</p>
        </div>
      </div>
      
      <!-- Actions -->
      <div class="flex items-center gap-3">
        <button onclick="exportToCSV()" class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 text-xs font-semibold transition border border-slate-700 flex items-center gap-2">
          <i class="fa-solid fa-file-csv text-emerald-400 text-sm"></i> Export CSV
        </button>
        <button onclick="seedSampleData()" class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold transition shadow-lg shadow-blue-600/30 flex items-center gap-2">
          <i class="fa-solid fa-magic text-sm"></i> Load Demo Data
        </button>
      </div>
    </header>

    <!-- Top KPI Dashboard Cards -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      
      <div class="glass-card glass-card-hover p-5 rounded-2xl border border-slate-800">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Stock Count</p>
            <h3 id="stat-total-items" class="text-3xl font-bold text-slate-100 mt-2">0</h3>
          </div>
          <div class="p-3 bg-blue-500/10 text-blue-400 rounded-xl">
            <i class="fa-solid fa-boxes-stacked text-xl"></i>
          </div>
        </div>
      </div>

      <div class="glass-card glass-card-hover p-5 rounded-2xl border border-slate-800">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Potential Revenue</p>
            <h3 id="stat-total-revenue" class="text-3xl font-bold text-emerald-400 mt-2">$0.00</h3>
          </div>
          <div class="p-3 bg-emerald-500/10 text-emerald-400 rounded-xl">
            <i class="fa-solid fa-chart-line text-xl"></i>
          </div>
        </div>
      </div>

      <div class="glass-card glass-card-hover p-5 rounded-2xl border border-slate-800">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Estimated Profit</p>
            <h3 id="stat-total-profit" class="text-3xl font-bold text-cyan-400 mt-2">$0.00</h3>
          </div>
          <div class="p-3 bg-cyan-500/10 text-cyan-400 rounded-xl">
            <i class="fa-solid fa-sack-dollar text-xl"></i>
          </div>
        </div>
      </div>

      <div class="glass-card glass-card-hover p-5 rounded-2xl border border-slate-800">
        <div class="flex justify-between items-start">
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Stock Alerts (&lt; 5)</p>
            <h3 id="stat-low-stock" class="text-3xl font-bold text-rose-500 mt-2">0</h3>
          </div>
          <div class="p-3 bg-rose-500/10 text-rose-400 rounded-xl">
            <i class="fa-solid fa-triangle-exclamation text-xl"></i>
          </div>
        </div>
      </div>
    </section>

    <!-- NEW FEATURE: Interactive Visual Analytics Charts -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="glass-card p-5 rounded-2xl border border-slate-800">
        <h3 class="text-sm font-bold text-slate-300 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-chart-pie text-cyan-400"></i> Category Stock Distribution
        </h3>
        <div class="h-56 relative flex items-center justify-center">
          <canvas id="categoryChart"></canvas>
        </div>
      </div>

      <div class="glass-card p-5 rounded-2xl border border-slate-800">
        <h3 class="text-sm font-bold text-slate-300 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-chart-bar text-emerald-400"></i> Profitability Optimizer
        </h3>
        <div class="h-56 relative flex items-center justify-center">
          <canvas id="profitChart"></canvas>
        </div>
      </div>
    </section>

    <!-- Main Section: Form & Table -->
    <main class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Product Input Form -->
      <section class="glass-card p-6 rounded-2xl border border-slate-800 h-fit space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <h2 id="form-title" class="text-base font-bold text-slate-100 flex items-center gap-2">
            <i class="fa-solid fa-plus-circle text-blue-400"></i> Add New Product
          </h2>
          <span id="edit-badge" class="hidden px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">Editing</span>
        </div>

        <form id="product-form" class="space-y-4">
          <input type="hidden" id="product-id" />

          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Product Name</label>
            <input type="text" id="p-name" required placeholder="e.g. Wireless Gaming Mouse" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:border-blue-500 transition" />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Category</label>
            <input type="text" id="p-category" required placeholder="e.g. Electronics" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:border-blue-500 transition" />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Quantity</label>
              <input type="number" id="p-qty" min="0" required placeholder="10" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:border-blue-500 transition" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Expiry Date</label>
              <input type="date" id="p-expiry" required class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:border-blue-500 transition" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Cost Price ($)</label>
              <input type="number" step="0.01" min="0" id="p-cost" required placeholder="25.00" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:border-blue-500 transition" />
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Selling Price ($)</label>
              <input type="number" step="0.01" min="0" id="p-price" required placeholder="49.99" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:border-blue-500 transition" />
            </div>
          </div>

          <div class="pt-2 flex gap-3">
            <button type="submit" id="btn-submit" class="flex-1 py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition shadow-lg shadow-blue-600/30 flex items-center justify-center gap-2">
              <i class="fa-solid fa-check"></i> Save Product
            </button>
            <button type="button" id="btn-cancel" onclick="resetForm()" class="hidden py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm transition border border-slate-700">
              Cancel
